{
  "workbench.editor.closeOnFileDelete": true,
  "explorer.autoReveal": true,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.renderWhitespace": "trailing",
  // git
  "git.mergeEditor": true,
  "git.autofetch": true,
  // formatting on save
  "files.autoSave": "off",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // bracket color pairs
  "editor.bracketPairColorization.enabled": true,
  "editor.matchBrackets": "near",
  "editor.guides.bracketPairs": true,
  "window.title": "${dirty}${activeEditorShort}${separator}${rootNameShort}",
  "window.menuBarVisibility": "toggle", // press alt to toggle
  "window.commandCenter": false,
  "window.titleBarStyle": "native",
  "workbench.layoutControl.enabled": false,

  // disable telemetry
  "telemetry.enableCrashReporter": false,
  "telemetry.enableTelemetry": false,
  "telemetry.telemetryLevel": "off",
  "telemetry.feedback.enabled": false,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,

  // theme
  "workbench.iconTheme": "catppuccin-mocha",
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
    // Nix settings
  "nix.enableLanguageServer": true,
  "nix.formatterPath": [
    "nixpkgs-fmt",
    "nixfmt",
    "treefmt",
    "--stdin",
    "{file}",
    "nix",
    "fmt",
    "--",
    "-"
  ],
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [
          "nixpkgs-fmt"
        ]
      },
      "nixpkgs": {
        "expr": "import (builtins.getFlake \"${workspaceFolder}\").inputs.nixpkgs {}"
      },
      "options": {
        "home_manager": {
         /*the below is for those who directly integrate their home manager into nixos, what others use is for stand alone home manager*/
          "expr": "(builtins.getFlake \"${workspaceFolder}\").nixosConfigurations.<name>.options.home-manager.users.type.getSubOptions []"
        },
        "nixos": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").nixosConfigurations.<name>.options"
        }
      }
    }
  },

  "[jsonc]": {
    "prettier.trailingComma": "all",
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.suggest.insertMode": "replace"
  },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "explorer.confirmDragAndDrop": false,
  "workbench.colorTheme": "Catppuccin Mocha",
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  }
}
