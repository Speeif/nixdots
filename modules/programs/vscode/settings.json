{
  "workbench.editor.closeOnFileDelete": true,
  "explorer.autoReveal": true,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.renderWhitespace": "trailing",
  // git
  "git.mergeEditor": true,
  "git.autofetch": true,
  // formatting on save
  "files.autoSave": "off",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // bracket color pairs
  "editor.bracketPairColorization.enabled": true,
  "editor.matchBrackets": "near",
  "editor.guides.bracketPairs": true,
  "window.title": "${dirty}${activeEditorShort}${separator}${rootNameShort}",
  "window.menuBarVisibility": "toggle", // press alt to toggle
  "window.commandCenter": false,
  "window.titleBarStyle": "native",
  "workbench.layoutControl.enabled": false,

  // disable telemetry
  "telemetry.enableCrashReporter": false,
  "telemetry.enableTelemetry": false,
  "telemetry.telemetryLevel": "off",
  "telemetry.feedback.enabled": false,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,

  // theme
  "workbench.iconTheme": "catppuccin-mocha",
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "nix.serverPath": "nixd",
  "nix.enableLanguageServer": true,
  "nix.formatterPath": "alejandra",
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": ["alejandra"]
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"/home/speeif/nix/flake\").nixosConfigurations.laptop.options"
        },
        "home_manager": {
          "expr": "(builtins.getFlake \"/home/speeif/nix/flake\").homeConfigurations.laptop.options"
        }
      }
    }
  },
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  },
  "[jsonc]": {
    "prettier.trailingComma": "all",
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.suggest.insertMode": "replace"
  },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },
  "explorer.confirmDragAndDrop": false,
  "workbench.colorTheme": "Catppuccin Mocha"
}
