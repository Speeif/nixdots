{
  // Place your flake workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  // "Print to console": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "log",
  // 	"body": [
  // 		"console.log('$1');",
  // 		"$2"
  // 	],
  // 	"description": "Log output to console"
  // }
  //
  // You can also restrict snippets to specific files using include/exclude patterns:
  // "Test snippet": {
  // 	"scope": "javascript,typescript",
  // 	"prefix": "test",
  // 	"body": "test('$1', () => {\n\t$0\n});",
  // 	"include": ["**/*.test.ts", "*.spec.ts"],
  // 	"exclude": ["**/temp/*.ts"],
  // 	"description": "Insert test block"
  // }
  "dentritic module": {
    "prefix": "dendritic",
    "body": [
      "{",
      "  inputs,",
      "  self,",
      "  ...",
      "}:",
      "let",
      "  moduleName = \"$1\";",
      "in",
      "{",
      "  flake.nixosModules.\"\\${moduleName}\" =",
      "\t{ pkgs, config, ... }:",
      "\t{",
      "\t  programs.$2 = {",
      "\t\tenable = true;",
      "\t\tpackage = self'.packages.\"\\${moduleName}\";",
      "\t  };",
      "\t};",
      "",
      "  flake.homeModules.\"\\${moduleName}\" =",
      "\t{ pkgs, config, ... }:",
      "\t{",
      "\t  programs.$2 = {",
      "\t\tenable = true;",
      "\t\tpackage = self'.packages.\"\\${moduleName}\";",
      "\t  };",
      "\t};",
      "",
      "  perSystem =",
      "\t{",
      "\t  pkgs,",
      "\t  self',",
      "\t  lib,",
      "\t  ...",
      "\t}:",
      "\t{",
      "\t  packages.\"\\${moduleName}\" = inputs.wrapperModules.wrappers.$2.wrap {",
      "\t\tinherit pkgs;",
      "\t\t$0",
      "\t  };",
      "\t};",
      "}",
    ],
    "description": "Creates a module using the dendritic pattern using flake-parts",
  },
  "wrapModule": {
    "prefix": "wrapmodule",
    "body": [
      "flake.wrapperModules.\"$1\" = inputs.wrappers.lib.wrapModule (",
      "\t{",
      "\t  config,",
      "\t  lib,",
      "\t  ...",
      "\t}: let",
      "\t  tomlFormat = config.pkgs.formats.toml {};",
      "\tin {",
      "\t  options = {",
      "\t\tsettings = lib.mkOption {",
      "\t\t  type = tomlFormat.type;",
      "\t\t};",
      "\t  };",
      "",
      "\t  config = {",
      "\t\tpackage = config.pkgs.$2;",
      "\t\tflags = {",
      "\t\t  \"--theme\" = tomlFormat.generate \"theme.toml\" config.settings;",
      "\t\t};",
      "\t  };",
      "\t}",
      "  );",
    ],
    "description": "Inserts a flake-parts wrappermodules configuration example",
  },
}
